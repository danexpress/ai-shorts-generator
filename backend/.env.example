# Export these variables before starting the backend; this file is not auto-loaded.
# Relative SQLite paths are resolved from the server's working directory.
# When unset, DATABASE_URL defaults to backend/ai_shorts.db via an absolute path.
DATABASE_URL=sqlite+pysqlite:///./ai_shorts.db
SEED_DEMO_DATA=true
# Public URLs: Google redirects to BACKEND_PUBLIC_URL/v1/auth/google/callback and
# then back to FRONTEND_PUBLIC_URL. Serve both from the same host (site) so the
# SameSite=Lax session cookies are sent; use HTTPS outside local development.
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Google Sign-In (OAuth web client). Sign-in requests only openid email profile.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email/password sign-in for demo accounts and development; set false in production.
ALLOW_PASSWORD_LOGIN=true
# Private beta: comma-separated emails allowed to create an account with Google
# (existing invited users are linked automatically). OPEN_SIGNUP=true allows anyone.
BETA_INVITE_EMAILS=
OPEN_SIGNUP=false
YOUTUBE_IMPORT=false
MEDIA_DIR=./media
MEDIA_SIGNING_KEY=replace-with-a-private-random-value
# local = real transcription by `make worker`; demo = simulated processing, no worker.
PROCESSING_MODE=local
# faster-whisper model: tiny, base, small, medium, large-v3 (larger is slower, more accurate).
WHISPER_MODEL=small
# auto picks CUDA when available, otherwise CPU (int8). There is no Apple GPU backend.
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
# Empty auto-detects the language; set e.g. en to skip detection.
WHISPER_LANGUAGE=
# Set to whisperx for forced alignment after `uv sync --extra align`.
WHISPER_ALIGN=
# Highlight detection with the Claude API. Credentials: ANTHROPIC_API_KEY (or
# ANTHROPIC_AUTH_TOKEN / an `ant auth login` profile). HIGHLIGHT_MODEL=demo uses
# the built-in demo analyzer and needs no key.
# ANTHROPIC_API_KEY=
HIGHLIGHT_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (higher = more thorough, more output tokens).
HIGHLIGHT_EFFORT=high
HIGHLIGHT_CANDIDATES=3
# Transcripts estimated above this many tokens are split into overlapping windows.
HIGHLIGHT_WINDOW_TOKENS=100000
# default = server-side refusal fallback (Opus/Sonnet/Fable); off disables it.
HIGHLIGHT_FALLBACKS=default
# Re-rank with audio loudness and scene changes (two extra FFmpeg passes).
HIGHLIGHT_SIGNALS=false
# Optional; imageio-ffmpeg is used when this is unset.
# FFMPEG_BIN=/usr/local/bin/ffmpeg

# Future PostgreSQL connection (install a compatible psycopg driver first):
# DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/ai_shorts
