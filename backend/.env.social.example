# Copy to backend/.env (gitignored) and replace placeholders; export in API/worker shells.
BACKEND_PUBLIC_URL=https://api.your-domain.example
FRONTEND_PUBLIC_URL=https://app.your-domain.example
CORS_ORIGINS=https://app.your-domain.example
DATABASE_URL=sqlite+pysqlite:////absolute/path/to/ai-shorts.db
MEDIA_DIR=/absolute/path/to/media
SOCIAL_TOKEN_ENCRYPTION_KEYS=REPLACE_WITH_A_PERSISTENT_FERNET_KEY
SOCIAL_ALLOW_INSECURE_LOCALHOST=false
ENABLE_YOUTUBE_PUBLISHING=false
ENABLE_TIKTOK_PUBLISHING=false
ENABLE_X_PUBLISHING=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_PUBLISHING_VERIFIED=false
# TikTok CLIENT_ID is the app's client key.
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_PUBLISHING_AUDITED=false
X_CLIENT_ID=
X_CLIENT_SECRET=
# OpenAI-compatible Chat Completions endpoint supporting strict json_schema.
SOCIAL_COPY_API_URL=https://api.openai.com/v1/chat/completions
SOCIAL_COPY_API_KEY=
SOCIAL_COPY_MODEL=
